# ProtonVPN OpenVPN/IKEv2 credentials
OPENVPN_USERNAME=
OPENVPN_PASSWORD=

OPENVPN_PROVIDER=protonvpn
# Config name without .ovpn — see vpn-configs-contrib/openvpn/protonvpn
OPENVPN_CONFIG=nl.protonvpn.udp

LOCAL_NETWORK=192.168.0.0/16

# Host ports clients connect to (mapped → container 8888 / 1080)
PROXY_HTTP_PORT=8888
PROXY_SOCKS_PORT=7888

# false + devices:/dev/net/tun  |  true = mknod inside (no device mount)
CREATE_TUN_DEVICE=false

# Port forward: put +pmp on username (Proton P2P server + paid PF).
# Example: OPENVPN_USERNAME=xxxx+pmp
# If +pmp set but NAT-PMP fails → container stops.

# PROXY_USER=
# PROXY_PASSWORD=
